{
  "name": "visionbook-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Bundled Android WebView app for Building Vision AI.",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "sync": "npm run prepare:web && cap sync android",
    "build:android": "npm run sync && node scripts/build-android.mjs",
    "build:apk": "npm run build:android && node scripts/copy-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^6.0.3"
  }
}
